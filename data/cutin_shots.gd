class_name CutinShots

## 궁극기 컷인 카메라가 훑는 지점.
##
## assets/art/standing/<id> 기준 **정규화 좌표**(0~1)다. 픽셀로 두면 일러스트를
## 교체하거나 크기를 바꿀 때마다 전부 다시 재야 한다.
##
## ── 왜 무기부터 보여 주는가 ──────────────────────────────────────────────
## 궁극기 컷인의 목적은 "누구의 무엇이 터졌는가" 를 이름 읽기 전에 알리는 것이다.
## 얼굴부터 보여 주면 여섯 명을 구분하는 데 시간이 걸리지만, 총구·바이올린·방패는
## 한 프레임이면 갈린다. 그래서 무기 → 얼굴 → 눈 순서다.
##
## ── weapon 은 화면 안에 있어야 한다 ─────────────────────────────────────
## 무기 "끝" 이 늘 정답은 아니다. 총구나 도끼날은 일러스트 가장자리에 있는
## 경우가 많은데, 4.6배로 당기면 보이는 폭이 원화의 348px 뿐이라 가장자리를
## 찍으면 화면 절반이 빈다. 실제로 총사·궁수·방패병이 다 그렇게 잘렸다.
## 카메라가 좌표를 안쪽으로 당겨 주긴 하지만(battle_view._cam_pos), 그러면
## 노린 곳이 아닌 데를 비추게 된다. 처음부터 안쪽 지점을 찍는 편이 낫다.
##
## ── eye 는 얼굴이 아니라 눈이다 ──────────────────────────────────────────
## 카메라가 마지막에 박히는 곳이라 한 칸만 어긋나도 이마나 코를 확대하게 된다.
## 두 눈 사이가 아니라 **화면 쪽 눈**을 찍는 편이 낫다.
##
## ── weapon 은 eye 보다 아래여야 한다 ─────────────────────────────────────
## 2번 비트가 "얼굴까지 **위로** 이동" 이다. 무기가 눈보다 위에 있으면 카메라가
## 아래로 내려가면서 연출 의도가 뒤집힌다. 여섯 명 다 아래에 오도록 잡았다.

const TABLE: Dictionary = {
	# 도끼창을 어깨 너머로 당긴 자세. 날은 화면 밖으로 나가 있어서 자루를 쥔
	# 가시 건틀릿을 잡는다 - "무기를 쥐고 있다" 가 날 자체보다 잘 읽혔다.
	# crop 0.3 - 인물이 왼쪽에 있고 오른쪽이 도끼창과 여백이다. 기본값(오른쪽)
	# 이면 마지막 판에 무기만 남는다. 0 으로 끝까지 밀면 이번엔 얼굴이 판
	# 왼쪽 변에 붙어 잘린다. 왼쪽에서 30%% 지점이 어깨와 얼굴을 다 담는다.
	"warrior":   { "weapon": Vector2(0.24, 0.28), "eye": Vector2(0.66, 0.20),
		"crop": 0.3 },
	# 시위를 당긴 자세. 활대와 화살촉이 한 화면에 들어온다.
	# 활을 든 자세라 머리가 원화 위쪽에 몰려 있다. 다른 직업과 같은 기준으로
	# 잡으면 얼굴이 화면 아래로 처진다. eye 를 0.06 올려 눈높이를 맞춘다.
	"archer":    { "weapon": Vector2(0.71, 0.42), "eye": Vector2(0.44, 0.20) },
	# 바이올린 몸통과 활이 겹치는 지점. 이 직업을 가장 빨리 알리는 곳이다.
	# 전사와 같다. [칸타빌레] 마지막 판에 바이올린만 남아 있었다.
	"bard":      { "weapon": Vector2(0.70, 0.47), "eye": Vector2(0.55, 0.27),
		"crop": 0.3 },
	# 칼을 낮게 뒤로 뺀 자세. 날의 붉은 선이 보이는 곳을 잡는다.
	"assassin":  { "weapon": Vector2(0.71, 0.75), "eye": Vector2(0.47, 0.22) },
	# 총열. 소염기까지 가면 화면 밖이라 기관부 쪽을 잡는다.
	"musketeer": { "weapon": Vector2(0.71, 0.74), "eye": Vector2(0.53, 0.21) },
	# 방패 정면의 문양과 테두리. 투구 때문에 눈이 안 보이므로 eye 는 면갑 틈이다.
	"shieldman": { "weapon": Vector2(0.71, 0.52), "eye": Vector2(0.62, 0.185) },
}


## 없는 직업이면 화면 한가운데를 훑는다. 아트가 안 들어온 직업이 생겨도
## 컷인이 깨지지는 않아야 한다.
## ── crop ─────────────────────────────────────────────────────────────────
## 컷인 판은 폭 428px 짜리 세로 띠라, 가로가 넓은 원화는 대부분이 잘린다.
## 어느 쪽을 남길지를 그림마다 정한다. 0 이면 왼쪽 끝, 0.5 면 가운데,
## 1 이면 오른쪽 끝을 남긴다.
##
## 기본은 1(오른쪽)이다. 서브컬처 스탠딩은 인물이 오른쪽에 서고 왼쪽이 여백인
## 구도가 많아서, 가운데를 남기면 인물이 반쯤 걸린 채로 나온다.
## 그림을 갈아 끼우면 여기 숫자 하나만 만지면 된다.
static func of(unit_id: String) -> Dictionary:
	var d: Dictionary = TABLE.get(unit_id, {
		"weapon": Vector2(0.5, 0.7), "eye": Vector2(0.5, 0.25),
	})
	if not d.has("crop"):
		d = d.duplicate()
		d["crop"] = 1.0
	return d
