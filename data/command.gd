## 다음 단계로 올리는 데 드는 예산. 최대면 -1.
static func price(level: int) -> int:
	if level >= MAX_LEVEL:
		return -1
	return COST_CURVE[level]


## 그 항목의 현재 효과값. level 배수다.
static func amount(id: String, level: int) -> int:
	return int(TABLE.get(id, {}).get("per", 0)) * level


static func ids_in(group: String) -> Array[String]:
	var out: Array[String] = []
	for id in TABLE:
		if String(TABLE[id]["group"]) == group:
			out.append(String(id))
	return out


## ── 실험용 장치 ──────────────────────────────────────────────────────────
## 보유 모듈 하나를 **같은 축의 다른 모듈**로 바꾼다.
##
## 축을 넘어가면 안 된다. 표적을 위치로 바꿀 수 있으면 축의 의미가 사라진다.
## 축 안에서만 도니까 "표적 교리를 다듬는다" 가 된다.
