class_name Innates

## 직업 기본기. 카드와 완전히 같은 모양의 규칙이고, 규칙 엔진은 둘을 구분하지 않는다.
##
## ── 왜 슬롯 아래에 붙는가 ────────────────────────────────────────────────
## 기본기는 산 카드 3장을 전부 검사한 뒤에야 평가된다. 위에 두면 조건이 헐거운
## 기본기가 매번 먼저 발동해서 비싸게 산 카드가 영영 실행되지 않고,
## "우선순위가 곧 전략"이라는 이 게임의 코어가 통째로 죽는다.
##
## 아래에 두면 반대가 된다. 유닛은 아무 카드가 없어도 제 몫을 하고,
## 카드는 그 기본 행동을 덮어쓰는 상위 규칙이 된다.
##
## ── 왜 카드보다 약한가 ──────────────────────────────────────────────────
## 기본기가 유료 카드와 같은 성능이면 그 카드를 아무도 안 산다. 그래서 전부
## 대응 카드보다 약하게 잡았다. 예: 궁수 기본기는 적이 1칸 이내여야 물러나지만
## `거리 유지`(코스트 2)는 2칸에서 이미 물러난다 - 훨씬 일찍, 훨씬 안전하게.
##
## 악사만 예외다. 문턱이 아니라 **회복량**으로 값을 가른다. 이유는 아래 참조.

## 모든 유닛이 공통으로 갖는 최후의 골격. 이게 있어서 "아무것도 안 하는 유닛"이
## 사라진다. 목록의 맨 마지막이므로 위의 무엇도 안 맞을 때만 실행된다.
const BASE: Array[Dictionary] = [
	{
		"name": "기본 공격",
		"cond": "enemy_in_range",
		"cond_arg": 0,
		"act": "attack",
		"target": "nearest_enemy",
		# 위력 85%. 100 이면 `교전`(항상 → 가장 가까운 적 공격)의 실효 조건이 이 규칙과
		# 완전히 같아져서 코스트를 내고 공짜와 똑같은 걸 사게 된다. 기본기는 어설퍼야
		# 유료 공격 카드가 값을 한다.
		#
		# 처음엔 70 으로 잡았는데 스테이지 1 승률이 25.8% → 6.9% 로 무너졌다.
		# 적은 `교전` 카드를 들고 100%로 때리는데 플레이어의 무작위 빌드는 기본기
		# 의존도가 높아 너프가 한쪽에만 꽂힌 것이다. 85 면 교전이 여전히 +18% 우위다.
		"power": 85,
		"text": "사거리 안 → 가장 가까운 적 공격 (위력 85%)",
	},
	{
		"name": "기본 전진",
		"cond": "enemy_out_of_range",
		"cond_arg": 0,
		"act": "move_toward",
		"target": "nearest_enemy",
		"text": "사거리 밖 → 적에게 접근",
	},
]

## 직업별 고유 기본기. BASE 보다 먼저 검사한다.
const TABLE: Dictionary = {
	# 물러서지 않는다. 죽기 직전에 오히려 파고든다.
	# (결사 카드와 조건이 같지만 결사는 코스트 1짜리라 경제에 영향이 없다)
	"warrior": [
		{
			"name": "전사의 투지",
			"cond": "self_hp_below",
			# 결사 카드가 25% 라 문턱을 40% 로 벌려 놨다. 같은 값이면 두 규칙이
			# 항상 같은 순간에 후보가 되어 무엇이 왜 터졌는지 읽을 수 없다.
			"cond_arg": 40,
			# 원래는 `적에게 파고든다`(move_toward) 였는데, 그러면 행동·대상·거리가
			# `기본 전진` 과 똑같아 효과가 0이었다. 궁지에 몰리면 더 세게 친다로 바꿨다.
			# 기본 공격 85% / 교전 100% 보다 높아 확실히 구분된다.
			"act": "attack",
			"target": "nearest_enemy",
			"power": 110,
			"text": "내 HP < 40% → 가장 가까운 적을 더 세게 친다 (위력 110%)",
		},
	],

	# 코앞까지 붙은 적에게서만 한 칸 뺀다.
	# 거리 유지(코스트 4)는 2칸에서 이미 물러나므로 훨씬 강하다.
	"archer": [
		{
			"name": "궁수의 발놀림",
			"cond": "enemy_within",
			"cond_arg": 1,
			"act": "move_away",
			"target": "nearest_enemy",
			"text": "적이 1칸 이내 → 한 칸 물러난다",
		},
	],

	# 레가토(legato) - 음을 끊지 않고 잇는다. 매 틱 조금씩 흘려 넣는 회복이다.
	#
	# 다른 기본기와 달리 문턱이 없다시피 하다(누구든 1이라도 깎였으면 발동).
	# 그게 악사의 정체성이라 일부러 그렇게 뒀다: 악사는 "위급할 때 붙는 힐러" 가
	# 아니라 "붙어 있는 내내 새는 피를 메우는" 유닛이다. 대신 회복량이 작고
	# 딜을 거의 못 한다 - 매 틱 회복을 고르면 매 틱 공격을 못 하니까.
#
# 회복량은 유료 모듈 [구호] 의 **절반**이다. 이건 반드시 지켜야 한다.
# 예전에는 둘 다 BARD_HEAL 이었는데, 조건이 훨씬 넓은 무료 기본기가 코스트 4짜리
# 모듈을 그대로 대체해 버렸다. 악사에게 구호를 살 이유가 없었고, 악사를 2명
# 세우기만 하면 모듈 하나 없이 매 틱 40 회복이 나왔다.
# 무료로 나오는 것은 사는 것보다 약해야 한다.
	#
	# 한 번에 크게 붓는 쪽은 궁극기 [칸타빌레] 가 맡는다.
	"bard": [
		{
			"name": "레가토",
			"cond": "ally_hp_below",
			"cond_arg": 100,
			"act": "heal",
			"target": "lowest_hp_ally",
			"heal_amount": UnitData.BARD_HEAL / 2,
			"text": "다친 아군이 있으면 → 가장 위독한 아군을 조금 회복",
		},
	],

	# 개전 직후 후열로 파고든다. 이동 2와 맞물려 암살자의 정체성이 된다.
	# 대응하는 카드가 없는 고유 기능이라 경제와 무관하다.
	"assassin": [
		{
			"name": "암살자의 급습",
			"cond": "tick_below",
			"cond_arg": 4,
			"act": "move_toward",
			"target": "nearest_enemy",
			# 이동 보너스가 핵심이다. 이게 없으면 행동·대상·거리가 `기본 전진` 과
			# 완전히 같아서, 발동해 봐야 기본기가 했을 일을 그대로 하는 효과 0짜리
			# 규칙이 된다. 실제로 그 상태였고 감사가 발동 횟수로 잡아냈다.
			# 개전 3틱 동안만 한 칸 더 파고드는 것이 암살자의 정체성이다.
			"move_bonus": 1,
			"text": "전투 시작 3틱 → 가장 가까운 적에게 급습 (한 칸 더)",
		},
	],

	# 사거리 2 짜리 인파이팅 원딜. 물러나는 기본기를 주면 안 된다 -
	# 사거리와 후퇴 문턱이 붙어 있어서 물러나는 순간 영영 못 쏘는 유닛이 된다.
	# 진짜 "빠지는" 행동은 궁극기 [거리두기] 가 한 번만, 값을 받고 해 준다.
	#
	# 조건 자리를 찾는 데 두 번 걸렸다. 기록해 둔다 -
	#   `적이 1칸 이내`     → 궁극기 [거리두기] 와 완전히 같다
	#   `직전 틱에 맞았으면` → 카드 [반격]·[회피] 와 완전히 같다
	#   `주변 적 2/3명 이상` → 카드 [방어 태세]·방패병 기본기와 같다
	# 같은 순간에 두 규칙이 후보가 되면 무엇이 왜 터졌는지 읽을 수 없다.
	#
	# 남은 자리는 `self_hp_below 70` 이었다(후퇴 50 / 결사 25 와 안 겹친다).
	# 붙어서 싸우는 원딜이라 피가 깎이는 게 전제고, 깎일수록 물러나는 게 아니라
	# 더 붙어서 갈긴다 - 총사는 거리를 두지 않는다는 컨셉과 방향이 같다.
	"musketeer": [
		{
			"name": "총사의 배수진",
			"cond": "self_hp_below",
			"cond_arg": 70,
			"act": "attack",
			"target": "nearest_enemy",
			# 평타(85%)와 교전(100%) 사이. 유료 공격 카드의 자리를 뺏지 않는다.
			"power": 95,
			"text": "내 HP < 70% → 물러서지 않고 밀착 사격 (위력 95%)",
		},
	],

	# 앞뒤로 물렸을 때 웅크린다.
	#
	# 문턱이 3명이었는데 감사가 1680회 전투에서 **0회 발동**으로 잡았다.
	# 스테이지 1 을 전사 셋에서 둘로 줄이면서 3명 포위 자체가 성립하지 않게 됐고,
	# 다른 스테이지도 적이 셋뿐이라 전원이 한 유닛을 둘러싸는 일은 거의 없다.
	# 2명이면 카드 [방어 태세](코스트 2, 같은 조건)와 겹치므로 다른 축으로 간다:
	# **맞은 다음 턴에 웅크린다.** 조건이 겹치지 않고 방패병답다.
	"shieldman": [
		{
			"name": "방패병의 버팀",
			#  은 카드 [반격]과 완전히 같아서 감사에 걸렸다.
			# 남은 자리는 `주변 적 1명 이상`(방어 태세 카드는 2명부터)이다.
			#
			# 행동은 방어가 아니라 **공격**이다. 방어로 두면 적이 붙어 있는 내내
			# 웅크리기만 해서 피해를 하나도 못 내고, 그러면 정체 규칙(14틱 무피해
			# 패배)에 스스로 걸린다. 웅크리는 건 카드 [방어 태세]와 궁극기
			# [최후의 수호]가 맡는다. 기본기는 최소한의 반격이면 된다.
			"cond": "enemies_adjacent_at_least",
			"cond_arg": 1,
			"act": "attack",
			"target": "nearest_enemy",
			"power": 115,
			"text": "적이 1명 이상 붙으면 → 방패로 밀어친다 (위력 115%)",
		},
	],
}


## 그 유닛이 실제로 쓰는 기본기 전체. 직업 고유 → 공통 골격 순서.
static func for_unit(type_id: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for r in TABLE.get(type_id, [] as Array):
		out.append(r)
	for r in BASE:
		out.append(r)
	return out
