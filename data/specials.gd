## ── 궁극기 합성 ──────────────────────────────────────────────────────────
## 모듈 합성과 **같은 규칙**이다. 같은 궁극기를 두 장 들고 있으면 한 장을
## 소모해 한 단계 올린다. 예산도 든다.
##
## 예산만으로 살 수 있게 해 봤다가 되돌렸다. 그러면 궁극기 강화가 "돈을 얼마나
## 모았나" 의 함수가 되어, 무엇을 주웠는지와 무관해진다. 같은 것이 두 번 나온
## 다는 것 자체가 이 런이 그 방향으로 흘렀다는 뜻이고, 합성은 그 흐름을 타는
## 선택이어야 한다.
##
## 셋까지다. 넷을 넘어가면 궁극기 하나가 편성 전체를 대신한다.
##
## per 는 단계당 값이다. 무엇에 얹히는지는 궁극기마다 다르다 - 여섯이 하는
## 일이 다 다른데 하나의 축(위력 같은)으로 통일하면 그중 절반은 엉뚱한 곳이
## 세진다.
const MERGE_MAX: int = 3

## 한 단계 올리는 데 필요한 장수. 모듈과 같다 - 2장을 넣고 1장이 남는다.
const MERGE_COPIES: int = 2

## 단계별 예산. 장수를 이미 치렀으므로 모듈 합성과 비슷한 선에서 끊는다.
const MERGE_COST: Array[int] = [4, 7, 11]

const MERGE: Dictionary = {
	# 위력이 오른다. 붙은 적을 한 번에 지우는 쪽으로 민다.
	"keep_off": { "per": 25, "text": "타격 위력 +25%p" },
	# 이후 모든 공격에 얹히는 값이 커진다. 궁수는 원래 "나중에 받는" 직업이다.
	"focus_fire": { "per": 12, "text": "이후 공격 위력 가산 +12%p" },
	# ── 비영천참만 성격이 다르다 ─────────────────────────────────────────
	# 1단계에서 **이 궁극기로 처치하면** 다시 찬다. 아무나 죽을 때가 아니다 -
	# 그러면 암살자가 가만히 있어도 재충전되어, 잘 쓰는 것과 안 쓰는 것이
	# 같아진다. 자기 손으로 끊었을 때만 다시 오는 편이 "누구를 지울지" 라는
	# 판단에 값을 매긴다.
	#
	# 2·3단계는 위력이다. 재충전이 되므로 위력은 조금만 올린다 - 둘 다 크게
	# 주면 후열이 매 페이즈 통째로 지워진다.
	"shadow_rend": { "per": 20, "text": "처치 시 재충전(1단계~) · 위력 +20%p" },
	# 버티는 3틱은 그대로다. 그 3틱 동안 공격력이 오른다 - 부활 문턱(30 피해)을
	# 넘기는 일 자체가 이 궁극기의 승부처이므로, 거기에 값을 얹는 게 맞다.
	"unyielding": { "per": 30, "text": "버티는 동안 ATK +30%" },
	# 방어가 두꺼워진다. 밀어내는 칸은 안 건드린다 - 그건 위치 규칙이라
	# 수치가 아니라 판을 바꾼다.
	"last_guard": { "per": 1, "text": "방어 태세 단계 +1" },
	# 회복량이 커진다.
	"cantabile": { "per": 14, "text": "회복량 +14" },
}


## 그 궁극기의 단계별 효과값.
static func merge_amount(sid: String, level: int) -> int:
	return int(MERGE.get(sid, {}).get("per", 0)) * maxi(level, 0)


## 다음 단계 비용. 최대면 -1.
static func merge_price(level: int) -> int:
	if level >= MERGE_MAX:
		return -1
	return MERGE_COST[level]


## 상점 등장 순서 고정용.
const ORDER: Array[String] = [
	"keep_off", "focus_fire", "shadow_rend", "unyielding", "last_guard", "cantabile",
]


static func get_special(sid: String) -> Dictionary:
	return TABLE[sid]


## 그 유닛이 쓸 수 있는 궁극기 id. 없으면 "".
static func for_unit(type_id: String) -> String:
	for sid in ORDER:
		if String(TABLE[sid]["unit"]) == type_id:
			return sid
	return ""


static func usable_by(sid: String, type_id: String) -> bool:
	return TABLE.has(sid) and String(TABLE[sid]["unit"]) == type_id


## 규칙 엔진이 후보로 올릴 수 있는가. 패시브는 행동이 아니라 상태 가로채기다.
static func is_passive(sid: String) -> bool:
	return TABLE.has(sid) and bool(TABLE[sid].get("passive", false))
