; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PROJECT RECLAIM"
config/description="프로젝트 리클레임 - 규칙을 짜서 AI를 싸우게 하는 격자 오토배틀러"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; ── 2D 텍스처를 밉맵으로 샘플링한다 ─────────────────────────────────────
; 기본값(Linear)은 원본보다 작게 그릴 때 원본 픽셀을 그대로 집어 온다. 그래서
; 1100px 짜리 일러스트를 400px 로 줄여 그리면 가는 선이 프레임마다 다른 픽셀에
; 걸려 **지직거린다.** 확대·축소가 섞이는 화면(컷인·초상·지형)에서 특히 심하다.
;
; 밉맵을 쓰면 미리 줄여 둔 단계에서 골라 오므로 그 떨림이 사라진다.
; 텍스처 쪽 mipmaps/generate 도 같이 켜야 실제로 만들어진다(.import).
;   3 = Linear Mipmap
rendering/textures/canvas_textures/default_texture_filter=3

[gui]

; 툴팁은 우리 UI 위젯이 아니라 Godot 이 직접 띄운다. 프로젝트 테마가
; 없으면 기본 폰트를 쓰는데 거기에는 한글 글리프가 없다 - 화면에 두부(░░)가
; 뜬다. 기본 폰트를 지정하면 툴팁까지 한 번에 해결된다.
theme/custom_font="res://assets/fonts/NexonLv2GothicBold.ttf"
